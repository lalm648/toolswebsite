# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# The Brahui learning app keeps its own git repository, its 3.8 MB source lexicon
# and its generator here. Only the build outputs belong to this site, and they are
# committed under public/brahui/ by `npm run sync:brahui`. Committing this folder
# would add a broken gitlink, not the files.
/Brahui-to-EN-URDU-Dictionary/

# typescript
*.tsbuildinfo
next-env.d.ts
readme-1.md
redme-1.md
readme-2.md
two
.env*

# isolated worktrees and subagent scratch
/.worktrees/
/.superpowers/

# Scans and photographs of dictionary sources. Kept out of the repo for the same
# reason /Brahui-to-EN-URDU-Dictionary/ is: they are somebody else's publication,
# read here to check and extend the lexicon, never redistributed. They must also
# stay out of public/, which Next.js serves at the web root.
/data/source-scans/

# Android (TWA) — see android/README.md
# The signing keystore must never be committed: anyone holding it can publish an
# update as you, and it is the one file that cannot be regenerated.
*.keystore
*.jks
android/app-release-*.apk
android/app-release-*.aab
android/*.idsig
android/build/
android/app/
android/gradle/
android/gradlew
android/gradlew.bat
android/local.properties
android/.gradle/
